rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;

      match /daily_logs/{date} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      match /pending_requests/{reqId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null;
      }
      match /friends/{friendId} {
        allow read, write: if request.auth != null;
      }
    }

    // OTP records are never touched by any client - only the Admin-SDK-backed
    // serverless functions (which bypass rules entirely) may read/write these.
    match /signup_otps/{email} {
      allow read, write: if false;
    }
    match /reset_otps/{email} {
      allow read, write: if false;
    }
  }
}
