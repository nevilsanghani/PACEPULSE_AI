<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background_glass"
    android:gravity="center">

    <!-- 3D Steps Badge Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_pill_steps"
        android:padding="6dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚶 0"
            android:textColor="#38BDF8"
            android:textSize="20sp"
            android:textStyle="bold"
            android:shadowColor="#8038BDF8"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:gravity="center" />
    </LinearLayout>

    <!-- 3D Calories Badge Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_pill_calories"
        android:padding="6dp">

        <TextView
            android:id="@+id/widget_calories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 0 kcal"
            android:textColor="#FFB800"
            android:textSize="14sp"
            android:textStyle="bold"
            android:shadowColor="#80FFB800"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:gravity="center" />
    </LinearLayout>

</LinearLayout>
