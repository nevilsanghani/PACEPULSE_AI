<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_background_glass"
    android:gravity="center">

    <!-- Header / Brand -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PacePulse AI"
        android:textColor="#38BDF8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- 3D Steps Badge Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_pill_steps"
        android:padding="4dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/widget_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚶 0"
            android:textColor="#38BDF8"
            android:textSize="18sp"
            android:textStyle="bold"
            android:shadowColor="#8038BDF8"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:gravity="center" />
    </LinearLayout>

    <!-- Sub Metrics Container: Calories & Distance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/widget_pill_calories"
        android:padding="4dp">

        <TextView
            android:id="@+id/widget_calories"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔥 0 kcal"
            android:textColor="#FFB800"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/widget_distance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📍 0.0 km"
            android:textColor="#00F2FE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>
